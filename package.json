{
  "name": "artiklt",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @artiklt/mobile --filter @artiklt/backend dev",
    "mobile": "pnpm --filter @artiklt/mobile start",
    "mobile:android": "pnpm --filter @artiklt/mobile android",
    "mobile:ios": "pnpm --filter @artiklt/mobile ios",
    "mobile:web": "pnpm --filter @artiklt/mobile web",
    "mobile:lint": "pnpm --filter @artiklt/mobile lint",
    "backend": "pnpm --filter @artiklt/backend dev",
    "backend:start": "pnpm --filter @artiklt/backend start",
    "backend:build": "pnpm --filter @artiklt/backend build",
    "backend:typecheck": "pnpm --filter @artiklt/backend typecheck",
    "backend:db:generate": "pnpm --filter @artiklt/backend db:generate",
    "backend:db:migrate": "pnpm --filter @artiklt/backend db:migrate",
    "backend:db:push": "pnpm --filter @artiklt/backend db:push",
    "backend:db:studio": "pnpm --filter @artiklt/backend db:studio",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
