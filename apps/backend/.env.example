PORT=3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artiklt

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (web client secret + platform client IDs)
