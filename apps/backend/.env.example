# Comma-separated origins allowed by CORS / Better Auth
CORS_ORIGIN=http://localhost:8081
TRUSTED_ORIGINS=http://localhost:8081,artiklt://

# AI / voice agents
LLM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
