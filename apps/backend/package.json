    "@livekit/agents-plugin-deepgram": "1.x",
    "@livekit/agents-plugin-google": "1.x",
    "@livekit/agents-plugin-openai": "1.x",
    "better-auth": "^1.7.25",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
